          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d03b3b"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (class) (count_over_time({log_type=\"access\", vhost=~\"$vhost\"} |= `$search` | label_format class=`{{ if eq .status \"499\" }}499{{ else }}{{ substr 0 1 .status }}xx{{ end }}` [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{class}}"
        }
      ]
    },
