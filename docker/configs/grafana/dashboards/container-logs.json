          },
          "queryType": "range",
          "expr": "sum(count_over_time({service=~\"$service\", log_type!~\"nextcloud|access|apache_access\", level=\"fatal\"} |= `$search` [$__auto]))",
          "legendFormat": "fatal"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "expr": "sum(count_over_time({service=~\"$service\", log_type!~\"nextcloud|access|apache_access\", level=\"error\"} |= `$search` [$__auto]))",
          "legendFormat": "error"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "expr": "sum(count_over_time({service=~\"$service\", log_type!~\"nextcloud|access|apache_access\", level=\"warn\"} |= `$search` [$__auto]))",
